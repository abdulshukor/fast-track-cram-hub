{
  "name": "certcram-pro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:validate": "tsx scripts/validate-content.ts",
    "start": "next start",
    "verify": "npm run typecheck && npm run content:validate && npm test && npm run build",
    "repo:check": "node scripts/check-public-release.cjs"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "22.15.30",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.3",
    "tailwindcss": "4.1.7",
    "tsx": "4.19.4",
    "typescript": "7.0.2",
    "vitest": "3.2.4"
  },
  "description": "Local-first, reusable Fast-Track Certification Cram Hub (early community preview)",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  }
}
